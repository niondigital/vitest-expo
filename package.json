{
  "name": "vitest-expo",
  "version": "57.0.0",
  "description": "Test Expo apps with Vitest \u2014 a drop-in replacement for jest-expo, built on vitest-native.",
  "license": "MIT",
  "author": "Sebastian Weyrauch <sw@nion-digital.com>",
  "bugs": "https://github.com/niondigital/vitest-expo/issues",
  "keywords": [
    "vitest",
    "expo",
    "expo-router",
    "react-native",
    "testing",
    "jest-expo"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    },
    "./snapshot-serializer": {
      "types": "./dist/snapshot-serializer.d.ts",
      "default": "./dist/snapshot-serializer.js"
    },
    "./types": "./types.d.ts",
    "./package.json": "./package.json",
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    },
    "./esm-loader": "./dist/esm-loader.js",
    "./setup-web": {
      "types": "./dist/setup-web.d.ts",
      "default": "./dist/setup-web.js"
    }
  },
  "bin": {
    "vitest-expo": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "types.d.ts",
    "MIGRATION.md",
    "MIGRATION-AGENTS.md"
  ],
  "sideEffects": [
    "./dist/setup.js",
    "./dist/setup-web.js",
    "./dist/router/index.js"
  ],
  "scripts": {
    "build": "tsup",
    "import-jest-expo-mocks": "node scripts/import-jest-expo-mocks.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:conformance": "npm run build && npm run test --workspace app",
    "check-spec-drift": "node scripts/check-spec-drift.mjs",
    "pack:local": "npm run build && npm pack --workspaces=false --pack-destination /tmp"
  },
  "dependencies": {
    "@oxc-project/runtime": "^0.144.0",
    "pretty-format": "^30.0.0"
  },
  "peerDependencies": {
    "@testing-library/react-native": ">=12 <15",
    "expo-router": "*",
    "react": ">=18",
    "vite": ">=6 <9",
    "vitest": ">=4 <6",
    "vitest-native": ">=0.11 <0.12"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "examples/app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niondigital/vitest-expo.git"
  }
}
