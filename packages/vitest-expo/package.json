{
  "name": "vitest-expo",
  "version": "0.1.0",
  "description": "Test Expo apps with Vitest — jest-expo parity on top of vitest-native.",
  "license": "MIT",
  "author": "Sebastian Weyrauch <sw@nion-digital.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swey/vitest-expo.git",
    "directory": "packages/vitest-expo"
  },
  "bugs": "https://github.com/swey/vitest-expo/issues",
  "keywords": [
    "vitest",
    "expo",
    "expo-router",
    "react-native",
    "testing",
    "jest-expo"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    },
    "./snapshot-serializer": {
      "types": "./dist/snapshot-serializer.d.ts",
      "default": "./dist/snapshot-serializer.js"
    },
    "./types": "./types.d.ts",
    "./package.json": "./package.json",
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    },
    "./esm-loader": "./dist/esm-loader.js"
  },
  "files": [
    "dist",
    "types.d.ts"
  ],
  "sideEffects": [
    "./dist/setup.js",
    "./dist/router/index.js"
  ],
  "scripts": {
    "build": "tsup",
    "import-jest-expo-mocks": "node scripts/import-jest-expo-mocks.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pretty-format": "^30.0.0"
  },
  "peerDependencies": {
    "@testing-library/react-native": ">=12 <15",
    "expo-router": "*",
    "react": ">=18",
    "vitest": ">=4 <6",
    "vitest-native": ">=0.11.0"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  }
}
